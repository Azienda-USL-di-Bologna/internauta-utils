    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <proc>none</proc>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.mysema.maven</groupId>
                <artifactId>apt-maven-plugin</artifactId>
                <version>1.1.3</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>process</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>target/generated-sources/java</outputDirectory>
                            <processor>com.querydsl.apt.jpa.JPAAnnotationProcessor</processor>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.querydsl</groupId> 
                        <artifactId>querydsl-apt</artifactId>
                        <version>5.1.0</version>
                        <classifier>jakarta</classifier>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.18.0</version>
                <executions>
                    <execution>
                        <id>erogatore</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            
                            <!--<project>sendintegration</project>-->
                            <addCompileSourceRoot>true</addCompileSourceRoot>
                            <inputSpec>
                                ${project.basedir}/src/main/resources/erogatore.yaml
                            </inputSpec>
                            <configOptions>
                                <title>send-integration</title>
                                <useSpringBoot3>true</useSpringBoot3>
                                <!--<serializationLibrary>gson</serializationLibrary>-->
                                <delegatePattern>true</delegatePattern>
                                <sourceFolder>/</sourceFolder>
                                <generatePom>false</generatePom>
                            </configOptions>
<!--                            <additionalProperties>
                                <parentGroupId>org.springframework.boot</parentGroupId>
                                <parentArtifactId>spring-boot-starter-parent</parentArtifactId>
                                <parentVersion>4.0.1</parentVersion>
                                <library>spring-boot</library>
                            </additionalProperties>-->
                            <generatorName>spring</generatorName>
                            
                            <apiPackage>it.bologna.ausl.internauta.service.sendintegration.controller</apiPackage>
                            <modelPackage>it.bologna.ausl.internauta.utils.sendintegration.model</modelPackage>
                            <!--<generateSupportingFiles>false</generateSupportingFiles>-->
                            <supportingFilesToGenerate>
                                ApiUtil.java
                            </supportingFilesToGenerate>
                            <output>target/generated-sources/java</output>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fruitore</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            
                            <!--<project>sendintegration</project>-->
                            <addCompileSourceRoot>true</addCompileSourceRoot>
                            <inputSpec>
                                ${project.basedir}/src/main/resources/fruitore.yaml
                            </inputSpec>
                            <configOptions>
                                <title>send-integration</title>
                                <useSpringBoot3>true</useSpringBoot3>
                                <!--<serializationLibrary>gson</serializationLibrary>-->
                                <!--<delegatePattern>true</delegatePattern>-->
                                <sourceFolder>/</sourceFolder>
                                <!--<testOutput>/</testOutput>-->
                                <!--<library>resttemplate</library>-->
                                <library>okhttp-gson</library>
                                <generateClientAsBean>true</generateClientAsBean>
                                <!--<library>webclient</library>-->
                                <useJakartaEe>true</useJakartaEe>
                                <dateLibrary>java8</dateLibrary>
                                <generatePom>false</generatePom>
                            </configOptions>
<!--                            <additionalProperties>
                                <parentGroupId>org.springframework.boot</parentGroupId>
                                <parentArtifactId>spring-boot-starter-parent</parentArtifactId>
                                <parentVersion>4.0.1</parentVersion>
                                <library>spring-boot</library>
                            </additionalProperties>-->
                            <!--<library>spring-boot</library>-->
                            <generatorName>java</generatorName>
                            
                            <apiPackage>it.bologna.ausl.internauta.service.sendintegration.api</apiPackage>
                            <modelPackage>it.bologna.ausl.internauta.utils.sendintegration.model</modelPackage>
                            <invokerPackage>it.bologna.ausl.internauta.utils.sendintegration.invoker</invokerPackage>
<!--                            <supportingFilesToGenerate>
                                ApiUtil.java
                            </supportingFilesToGenerate>-->
                            <!--<generateSupportingFiles>false</generateSupportingFiles>-->
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <output>target/generated-sources/java</output>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
