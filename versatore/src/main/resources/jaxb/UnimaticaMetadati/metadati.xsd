<?xml version="1.0" encoding="UTF-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    
    <xs:import schemaLocation="documentoAmministrativoInformatico.xsd"/>

    <xs:element name="Documento">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Intestazione">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="IdFile" type="xs:string"/>
                            <xs:element name="NomeFile" type="xs:string"/>
                            <xs:element name="Principale" type="xs:boolean"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
        
                <xs:element name="Profilo">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="MetadatiSpecifici">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="metadatoCustom" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>

                            <xs:element name="MetadatiAGID">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element ref="DocumentoAmministrativoInformatico" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
