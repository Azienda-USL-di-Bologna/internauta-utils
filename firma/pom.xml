    <build>
        <resources>
            <resource>
                <targetPath>META-INF</targetPath>
                <directory>src</directory>
                <includes>
                    <include>jax-ws-catalog.xml</include>
                    <include>wsdl/**</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <proc>none</proc>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>4.0.3</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>arss-firma-auslbo.avec.emr.it_8443/ArubaSignService/ArubaSignService.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>it.bologna.ausl.internauta.utils.firma.remota.data.arubasignservice.wsclient</packageName>
                            <vmArgs>
                                <vmArg>-Djakarta.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <wsdlLocation>https://arss-firma-auslbo.avec.emr.it:8443/ArubaSignService/ArubaSignService?wsdl</wsdlLocation>
                            <!--<wsdlLocation>https://arss.demo.firma-automatica.it/ArubaSignService/ArubaSignService?wsdl</wsdlLocation>-->
                            <staleFile>${project.build.directory}/jaxws/stale/ArubaSignService.stale</staleFile>
                        </configuration>
                        <id>wsimport-generate-ArubaSignService</id>
                        <phase>generate-sources</phase>
                    </execution>
                    <execution>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>arss-firma-auslbo.avec.emr.it_8443/ArubaSignService/CredentialProxyService.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>it.bologna.ausl.internauta.utils.firma.remota.data.arubasignservice.credentialproxy</packageName>
                            <vmArgs>
                                <vmArg>-Djakarta.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <wsdlLocation>https://arss-firma-auslbo.avec.emr.it:8443/ArubaSignService/CredentialProxyService?wsdl</wsdlLocation>
                            <staleFile>${project.build.directory}/jaxws/stale/CredentialProxyService.stale</staleFile>
                        </configuration>
                        <id>wsimport-generate-CredentialProxyService</id>
                        <phase>generate-sources</phase>
                    </execution>
                    <execution>
                        <id>wsimport-generate-syncsignV3</id>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>medas/syncsignV3.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>it.bologna.ausl.internauta.utils.firma.remota.medassignservice</packageName>
                            <vmArgs>
                                <vmArg>-Djakarta.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <wsdlLocation>https://scrybasign-cloud.medas-solutions.it/ScrybaSignServer/services/syncsign/v3?wsdl</wsdlLocation>
                            <staleFile>${project.build.directory}/jaxws/stale/syncsignV3.stale</staleFile>
                        </configuration>
                        <phase>generate-sources</phase>
                    </execution>
                    <execution>
                        <id>wsimport-generate-utilsV2.0_rev1</id>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>medas/utilsV2.0_rev1.wsdl</wsdlFile>
                            </wsdlFiles>
                            <wsdlLocation>https://scrybasign-cloud.medas-solutions.it/ScrybaSignServer/services/utils/v2?wsdl</wsdlLocation>
                            <packageName>it.bologna.ausl.internauta.utils.firma.remota.medassignservice</packageName>
                            <vmArgs>
                                <vmArg>-Djakarta.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <staleFile>${project.build.directory}/jaxws/stale/utilsV2.0_rev1.stale</staleFile>
                        </configuration>
                        <phase>generate-sources</phase>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>jakarta.xml.ws</groupId>
                        <artifactId>jakarta.xml.ws-api</artifactId>
                        <version>4.0.2</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <sourceDestDir>${project.build.directory}/generated-sources/jaxws-wsimport</sourceDestDir>
                    <xnocompile>true</xnocompile>
                    <verbose>true</verbose>
                    <extension>true</extension>
                    <catalog>${basedir}/src/jax-ws-catalog.xml</catalog>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.mysema.maven</groupId>
                <artifactId>apt-maven-plugin</artifactId>
                <version>1.1.3</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>process</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>target/generated-sources/java</outputDirectory>
                            <processor>com.querydsl.apt.jpa.JPAAnnotationProcessor</processor>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.querydsl</groupId>
                        <artifactId>querydsl-apt</artifactId>
                        <version>5.1.0</version>
                        <classifier>jakarta</classifier>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
